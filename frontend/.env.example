# ── Backend API ───────────────────────────────────────────────
# Base URL of the InvoiceAI REST API (no trailing slash)
# Development: http://localhost:3001/v1
# Production:  https://api.yourdomain.com/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
