# ──────────────────────────────────────────────────────────────
# InvoiceAI — Backend Environment Variables
# Copy this file to .env. Only DATABASE_URL, JWT_SECRET and FRONTEND_URL
# are required. Resend / OpenAI / Stripe keys are optional: leave them
# blank and that integration runs in demo mode (emails are logged, AI
# returns templates, checkout upgrades instantly).
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/invoiceai

# ── JWT Auth ──────────────────────────────────────────────────
# Secret key for signing access tokens — MUST be at least 32 chars
# Generate with: openssl rand -base64 32  (or: node -e "require('crypto').randomBytes(32).toString('base64')|console.log")
JWT_SECRET=

# Access token lifetime (e.g. 15m, 1h)
JWT_EXPIRY=15m

# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Email via Resend (https://resend.com) ─────────────────────
# Optional — without it emails are logged to the console (demo mode)
RESEND_API_KEY=re_...

# Sender address — must be verified in Resend dashboard
EMAIL_FROM=invoices@yourdomain.com

# ── OpenAI (https://platform.openai.com/api-keys) ─────────────
# Optional — without it follow-ups use built-in tone templates
OPENAI_API_KEY=sk-...

# ── Stripe (https://dashboard.stripe.com/apikeys) ─────────────
# Optional — without it billing is simulated. sk_test_... for dev, sk_live_... for prod
STRIPE_SECRET_KEY=sk_test_...

# Get from: Dashboard → Developers → Webhooks → Signing secret
# Local dev: use `stripe listen --forward-to localhost:3001/v1/billing/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# The Price ID for your PRO monthly plan
# Create in: Dashboard → Products → Add Product
STRIPE_PRO_PRICE_ID=price_...

# ── URLs ──────────────────────────────────────────────────────
# The URL where your frontend is served (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Port the backend listens on
PORT=3001

# Node environment: development | test | production
NODE_ENV=development
